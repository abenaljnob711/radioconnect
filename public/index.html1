<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<meta name="theme-color" content="#02050e">

<title>Radio Connect - صوت مباشر</title>

<script src="https://unpkg.com/livekit-client@2.15.3/dist/livekit-client.umd.min.js"></script>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  background:#02050e;
  color:#fff;
  font-family:Arial,sans-serif;
}

body{
  display:flex;
  align-items:center;
  justify-content:center;
}

.app{
  width:100%;
  max-width:500px;
  min-height:100%;
  padding:25px 18px;
  display:flex;
  flex-direction:column;
  align-items:center;
}

.logo{
  font-size:25px;
  font-weight:900;
  margin-top:20px;
}

.status{
  margin-top:10px;
  color:#79e6a0;
  font-size:14px;
  text-align:center;
}

.room{
  margin-top:25px;
  width:100%;
  background:#091121;
  border:1px solid #172743;
  border-radius:18px;
  padding:18px;
  text-align:center;
}

.roomCode{
  font-size:24px;
  font-weight:900;
  letter-spacing:4px;
  color:#6eb7ff;
  margin-top:8px;
}

.ptt{
  width:220px;
  height:220px;
  border-radius:50%;
  border:0;
  margin-top:55px;

  background:linear-gradient(145deg,#123a68,#07172c);

  box-shadow:
    0 0 0 10px rgba(54,143,255,.08),
    0 0 45px rgba(40,130,255,.18);

  color:#fff;
  font-size:25px;
  font-weight:900;

  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
}

.ptt:active,
.ptt.talking{
  background:linear-gradient(145deg,#a62020,#530c0c);

  box-shadow:
    0 0 0 10px rgba(255,70,70,.10),
    0 0 55px rgba(255,50,50,.45);

  transform:scale(.97);
}

.ptt:disabled{
  opacity:.45;
}

.hint{
  margin-top:25px;
  color:#8896aa;
  text-align:center;
  line-height:1.8;
}

#error{
  color:#ff7070;
  margin-top:18px;
  text-align:center;
  min-height:22px;
}

.remote{
  position:fixed;
  width:1px;
  height:1px;
  opacity:0;
  pointer-events:none;
}
</style>
</head>

<body>

<div class="app">

  <div class="logo">
    📻 Radio Connect
  </div>

  <div id="status" class="status">
    جاري الاتصال بالخدمة الصوتية...
  </div>

  <div class="room">
    الغرفة
    <div id="roomCode" class="roomCode">---</div>
  </div>

  <button
    id="ptt"
    class="ptt"
    type="button"
    disabled>
    اضغط للتحدث
  </button>

  <div class="hint">
    اضغط باستمرار لإرسال صوتك<br>
    ارفع إصبعك لإيقاف الإرسال
  </div>

  <div id="error"></div>

</div>

<div id="remoteAudioContainer" class="remote"></div>

<script>

/* =========================================================
   RADIO CONNECT
   LIVEKIT PTT VOICE
   ========================================================= */

const statusEl =
  document.getElementById("status");

const roomCodeEl =
  document.getElementById("roomCode");

const ptt =
  document.getElementById("ptt");

const errorEl =
  document.getElementById("error");

const remoteAudioContainer =
  document.getElementById("remoteAudioContainer");


/* =========================================================
   التحقق من LiveKit
   ========================================================= */

if (
  typeof LivekitClient === "undefined"
) {

  setStatus(
    "تعذر تحميل خدمة الصوت",
    "#ff7070"
  );

  showError(
    "LiveKit لم يتم تحميله"
  );

  throw new Error(
    "LivekitClient is not available"
  );
}


const {
  Room,
  RoomEvent,
  Track,
  createLocalAudioTrack
} = LivekitClient;


/* =========================================================
   الغرفة
   ========================================================= */

const params =
  new URLSearchParams(
    window.location.search
  );

let roomId =
  params.get("room") ||
  params.get("r") ||
  "";


if (!roomId) {

  roomId =
    Math.random()
      .toString(36)
      .substring(2,8)
      .toUpperCase();
}

roomId =
  roomId
    .trim()
    .toUpperCase();


roomCodeEl.textContent =
  roomId;


/* =========================================================
   المتغيرات
   ========================================================= */

let liveRoom = null;

let localAudioTrack = null;

let audioPublished = false;

let isTalking = false;

let connecting = false;


/* =========================================================
   Device ID
   ========================================================= */

let deviceId =
  localStorage.getItem(
    "radio_connect_device_id"
  );


if (!deviceId) {

  deviceId =
    "DEV-" +
    crypto.randomUUID();

  localStorage.setItem(
    "radio_connect_device_id",
    deviceId
  );
}


/* =========================================================
   الحالة
   ========================================================= */

function setStatus(
  text,
  color = "#79e6a0"
) {

  statusEl.textContent =
    text;

  statusEl.style.color =
    color;
}


function showError(
  text
) {

  errorEl.textContent =
    text || "";
}


/* =========================================================
   الحصول على Token
   ========================================================= */

async function getToken() {

  const response =
    await fetch(
      "/token?room=" +
      encodeURIComponent(roomId),
      {
        method:"GET",
        headers:{
          "x-device-id":
            deviceId
        },
        cache:"no-store"
      }
    );


  if (!response.ok) {

    let message =
      "تعذر الحصول على رمز الاتصال";

    try {

      const data =
        await response.json();

      if (data.error) {
        message =
          data.error;
      }

    } catch {}

    throw new Error(
      message
    );
  }


  const data =
    await response.json();


  if (
    !data.token ||
    !data.url
  ) {

    throw new Error(
      "بيانات LiveKit غير مكتملة"
    );
  }


  return data;
}


/* =========================================================
   اتصال LiveKit
   ========================================================= */

async function connectLiveKit() {

  if (connecting) {
    return;
  }

  if (
    liveRoom &&
    liveRoom.state === "connected"
  ) {
    return;
  }


  connecting = true;

  try {

    setStatus(
      "جاري الاتصال بالصوت...",
      "#ffd166"
    );


    const data =
      await getToken();


    liveRoom =
      new Room({
        adaptiveStream:true,
        dynacast:true
      });


    /* -----------------------------------------
       دخول شخص جديد
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.ParticipantConnected,
      participant => {

        setStatus(
          "تم الاتصال بالطرف الآخر",
          "#79e6a0"
        );

        showError("");
      }
    );


    /* -----------------------------------------
       خروج شخص
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.ParticipantDisconnected,
      participant => {

        setStatus(
          "الطرف الآخر خرج من الغرفة",
          "#ffd166"
        );
      }
    );


    /* -----------------------------------------
       اتصال الغرفة
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.Connected,
      () => {

        setStatus(
          "متصل بالغرفة الصوتية",
          "#79e6a0"
        );

        ptt.disabled =
          false;

        showError("");
      }
    );


    /* -----------------------------------------
       انقطاع الاتصال
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.Disconnected,
      reason => {

        ptt.disabled =
          true;

        setStatus(
          "انقطع الاتصال الصوتي",
          "#ff7070"
        );
      }
    );


    /* -----------------------------------------
       استقبال صوت الطرف الآخر
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.TrackSubscribed,
      (
        track,
        publication,
        participant
      ) => {

        if (
          track.kind ===
          Track.Kind.Audio
        ) {

          const element =
            track.attach();

          element.autoplay =
            true;

          element.playsInline =
            true;

          remoteAudioContainer
            .appendChild(
              element
            );

          element.play()
            .catch(() => {});

          setStatus(
            "متصل بالطرف الآخر",
            "#79e6a0"
          );
        }
      }
    );


    /* -----------------------------------------
       إزالة الصوت
    ----------------------------------------- */

    liveRoom.on(
      RoomEvent.TrackUnsubscribed,
      (
        track
      ) => {

        try {

          track.detach()
            .forEach(
              element => {
                element.remove();
              }
            );

        } catch {}
      }
    );


    /* -----------------------------------------
       دخول LiveKit
    ----------------------------------------- */

    await liveRoom.connect(
      data.url,
      data.token
    );


    setStatus(
      "بانتظار الطرف الآخر...",
      "#79e6a0"
    );

    ptt.disabled =
      false;


  } catch (error) {

    console.error(
      "LiveKit connection error:",
      error
    );


    ptt.disabled =
      true;


    setStatus(
      "تعذر الاتصال الصوتي",
      "#ff7070"
    );


    showError(
      error.message ||
      "تعذر الاتصال بخدمة الصوت"
    );


    liveRoom =
      null;


  } finally {

    connecting =
      false;
  }
}


/* =========================================================
   إنشاء الميكروفون
   ========================================================= */

async function createMicrophone() {

  if (
    !liveRoom ||
    liveRoom.state !==
      "connected"
  ) {

    await connectLiveKit();
  }


  if (!liveRoom) {

    throw new Error(
      "الاتصال الصوتي غير جاهز"
    );
  }


  /* -----------------------------------------
     إذا كان الميكروفون موجودًا
  ----------------------------------------- */

  if (localAudioTrack) {

    return localAudioTrack;
  }


  /* -----------------------------------------
     طلب إذن الميكروفون
  ----------------------------------------- */

  localAudioTrack =
    await createLocalAudioTrack({

      echoCancellation:true,

      noiseSuppression:true,

      autoGainControl:true,

      channelCount:1

    });


  /* -----------------------------------------
     نشر الميكروفون في الغرفة
  ----------------------------------------- */

  await liveRoom
    .localParticipant
    .publishTrack(
      localAudioTrack,
      {
        name:"radio-microphone"
      }
    );


  audioPublished =
    true;


  /* -----------------------------------------
     يبدأ مكتوم
  ----------------------------------------- */

  await localAudioTrack.mute();


  return localAudioTrack;
}


/* =========================================================
   بدء التحدث
   ========================================================= */

async function startTalking(
  event
) {

  if (event) {
    event.preventDefault();
  }


  if (isTalking) {
    return;
  }


  isTalking =
    true;


  ptt.classList.add(
    "talking"
  );


  ptt.textContent =
    "🎙️ تحدث الآن";


  showError("");


  try {

    /* -----------------------------------------
       الاتصال بالغرفة
    ----------------------------------------- */

    if (
      !liveRoom ||
      liveRoom.state !==
        "connected"
    ) {

      await connectLiveKit();
    }


    /* -----------------------------------------
       إنشاء الميكروفون
    ----------------------------------------- */

    const microphone =
      await createMicrophone();


    /* -----------------------------------------
       فتح الميكروفون
    ----------------------------------------- */

    await microphone.unmute();


    setStatus(
      "🎙️ أنت تتحدث الآن",
      "#ff6666"
    );


  } catch (error) {

    console.error(
      "Microphone error:",
      error
    );


    isTalking =
      false;


    ptt.classList.remove(
      "talking"
    );


    ptt.textContent =
      "اضغط للتحدث";


    let message =
      "تعذر تشغيل الميكروفون";


    if (
      error.name ===
      "NotAllowedError"
    ) {

      message =
        "تم رفض إذن الميكروفون. اسمح للمتصفح باستخدام الميكروفون ثم حاول مرة أخرى.";

    } else if (
      error.name ===
      "NotFoundError"
    ) {

      message =
        "لم يتم العثور على ميكروفون في الجهاز.";

    } else if (
      error.name ===
      "NotReadableError"
    ) {

      message =
        "الميكروفون مستخدم من تطبيق آخر.";

    } else if (
      error.message
    ) {

      message =
        error.message;
    }


    showError(
      message
    );


    setStatus(
      "الميكروفون متوقف",
      "#ff7070"
    );
  }
}


/* =========================================================
   إيقاف التحدث
   ========================================================= */

async function stopTalking(
  event
) {

  if (event) {
    event.preventDefault();
  }


  if (!isTalking) {
    return;
  }


  isTalking =
    false;


  ptt.classList.remove(
    "talking"
  );


  ptt.textContent =
    "اضغط للتحدث";


  try {

    if (localAudioTrack) {

      await localAudioTrack
        .mute();
    }

  } catch (error) {

    console.warn(
      "Mute error:",
      error
    );
  }


  if (
    liveRoom &&
    liveRoom.state ===
      "connected"
  ) {

    setStatus(
      "الميكروفون متوقف",
      "#79e6a0"
    );
  }
}


/* =========================================================
   أزرار PTT
   ========================================================= */

ptt.addEventListener(
  "pointerdown",
  startTalking
);


ptt.addEventListener(
  "pointerup",
  stopTalking
);


ptt.addEventListener(
  "pointercancel",
  stopTalking
);


ptt.addEventListener(
  "pointerleave",
  stopTalking
);


/* =========================================================
   منع سحب الصفحة أثناء الضغط
   ========================================================= */

ptt.addEventListener(
  "contextmenu",
  event => {
    event.preventDefault();
  }
);


/* =========================================================
   إذا خرج التطبيق من الشاشة
   أوقف الميكروفون
   ========================================================= */

document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.hidden &&
      isTalking
    ) {

      stopTalking();
    }

  }
);


/* =========================================================
   تنظيف عند إغلاق الصفحة
   ========================================================= */

window.addEventListener(
  "beforeunload",
  () => {

    try {

      if (localAudioTrack) {

        localAudioTrack.stop();
      }

      if (liveRoom) {

        liveRoom.disconnect();
      }

    } catch {}
  }
);


/* =========================================================
   بدء الاتصال
   ========================================================= */

connectLiveKit();

</script>

</body>
</html>
