name: Build Radio Connect APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Radio Connect APK
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Setup Java
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: 21

      - name: Check project files
        run: |
          test -f public/index.html
          test -f public/icon.png
          test -f package.json
          test -f capacitor.config.json

      - name: Install Capacitor
        run: |
          npm install --no-save --no-package-lock \
            @capacitor/core@7 \
            @capacitor/cli@7 \
            @capacitor/android@7

      - name: Prepare web files
        run: |
          mkdir -p www
          cp -R public/. www/

      - name: Verify Capacitor configuration
        run: |
          node -e "
          const c = require('./capacitor.config.json');

          if (c.appId !== 'com.radioconnect.app') {
            throw new Error('Wrong appId');
          }

          if (c.server?.url !== 'https://radio-connect-server.onrender.com') {
            throw new Error('Server URL is missing or incorrect');
          }

          console.log('Capacitor configuration OK');
          "

      - name: Create Android project
        run: |
          if [ ! -f android/gradlew ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Prepare app name and icon
        run: |
          python -m pip install Pillow

          python - <<'PY'
          from PIL import Image, ImageOps
          from pathlib import Path
          import re

          icon_path = Path("public/icon.png")
          icon = Image.open(icon_path).convert("RGBA")

          sizes = {
              "mipmap-mdpi": 48,
              "mipmap-hdpi": 72,
              "mipmap-xhdpi": 96,
              "mipmap-xxhdpi": 144,
              "mipmap-xxxhdpi": 192
          }

          for folder, size in sizes.items():
              directory = Path("android/app/src/main/res") / folder
              directory.mkdir(parents=True, exist_ok=True)

              resized = ImageOps.contain(icon, (size, size))
              canvas = Image.new(
                  "RGBA",
                  (size, size),
                  (0, 0, 0, 0)
              )

              x = (size - resized.width) // 2
              y = (size - resized.height) // 2

              canvas.alpha_composite(resized, (x, y))

              canvas.save(directory / "ic_launcher.png")
              canvas.save(directory / "ic_launcher_round.png")

          adaptive = Path(
              "android/app/src/main/res/mipmap-anydpi-v26"
          )

          if adaptive.exists():
              for name in (
                  "ic_launcher.xml",
                  "ic_launcher_round.xml"
              ):
                  file = adaptive / name
                  if file.exists():
                      file.unlink()

          strings = Path(
              "android/app/src/main/res/values/strings.xml"
          )

          content = strings.read_text(encoding="utf-8")

          content, count = re.subn(
              r'(<string name="app_name">).*?(</string>)',
              r'\g<1>جهاز لاسلكي نداء ودردشة حقيقي\g<2>',
              content,
              count=1
          )

          if count == 0:
              raise SystemExit("app_name not found")

          strings.write_text(content, encoding="utf-8")

          manifest = Path(
              "android/app/src/main/AndroidManifest.xml"
          )

          content = manifest.read_text(encoding="utf-8")

          permissions = [
              "android.permission.INTERNET",
              "android.permission.RECORD_AUDIO",
              "android.permission.MODIFY_AUDIO_SETTINGS",
              "android.permission.CAMERA",
              "android.permission.WAKE_LOCK"
          ]

          for permission in permissions:
              tag = (
                  f'<uses-permission android:name="{permission}" />'
              )

              if permission not in content:
                  content = content.replace(
                      "<application",
                      tag + "\n    <application",
                      1
                  )

          manifest.write_text(content, encoding="utf-8")

          print("App name, icon and permissions prepared")
          PY

      - name: Set app version
        run: |
          python - <<'PY'
          from pathlib import Path
          import re

          gradle = Path("android/app/build.gradle")
          content = gradle.read_text(encoding="utf-8")

          content, code_count = re.subn(
              r'versionCode\s+\d+',
              'versionCode 441',
              content,
              count=1
          )

          content, name_count = re.subn(
              r'versionName\s+["\'][^"\']+["\']',
              'versionName "4.4.1"',
              content,
              count=1
          )

          if code_count != 1 or name_count != 1:
              raise SystemExit(
                  "Could not set Android app version"
              )

          gradle.write_text(content, encoding="utf-8")

          print("App version: 4.4.1")
          print("Version code: 441")
          PY

      - name: Install Android SDK packages
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses

          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew

          ./gradlew \
            --no-daemon \
            --stacktrace \
            assembleDebug

      - name: Verify APK
        run: |
          test -f android/app/build/outputs/apk/debug/app-debug.apk

          ls -lh android/app/build/outputs/apk/debug/app-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v5
        with:
          name: radio-connect-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 14
