name: Build Radio Connect APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Java JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK packages
        run: |
          yes | sdkmanager --licenses || true
          sdkmanager --install \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Check project files
        run: |
          set -e

          if [ ! -d public ]; then
            echo "ERROR: public folder not found"
            exit 1
          fi

          if [ ! -f public/index.html ]; then
            echo "ERROR: public/index.html not found"
            exit 1
          fi

          if [ ! -f public/icon.png ]; then
            echo "ERROR: public/icon.png not found"
            exit 1
          fi

          echo "Project files verified"

      - name: Install Capacitor
        run: |
          set -e

          if [ ! -f package.json ]; then
            npm init -y
          fi

          npm install --no-audit --no-fund \
            @capacitor/core@^7 \
            @capacitor/cli@^7 \
            @capacitor/android@^7

      - name: Prepare Capacitor configuration
        run: |
          if [ ! -f capacitor.config.json ] && \
             [ ! -f capacitor.config.ts ] && \
             [ ! -f capacitor.config.js ]; then

            cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.radioconnect.app",
            "appName": "جهاز لاسلكي نداء ودردشة حقيقي",
            "webDir": "www",
            "android": {
              "allowMixedContent": true
            }
          }
          EOF
          fi

      - name: Create www folder
        run: |
          set -e

          mkdir -p www
          cp -R public/. www/

          test -f www/index.html

          echo "Web files copied successfully"

      - name: Add Android platform
        run: |
          set -e

          if [ -f android/gradlew ]; then
            echo "Android platform already exists"
          else
            npx cap add android
          fi

          npx cap sync android

      - name: Change Android App Name
        run: |
          set -e

          STRINGS="android/app/src/main/res/values/strings.xml"

          if [ -f "$STRINGS" ]; then
            sed -i \
              's|<string name="app_name">[^<]*</string>|<string name="app_name">جهاز لاسلكي نداء ودردشة حقيقي</string>|' \
              "$STRINGS"
          fi

      - name: Replace App Icons
        run: |
          set -e

          ICON="$GITHUB_WORKSPACE/public/icon.png"
          RES="android/app/src/main/res"

          test -f "$ICON"

          file "$ICON"
          ls -lh "$ICON"

          rm -f "$RES/mipmap-anydpi-v26/ic_launcher.xml"
          rm -f "$RES/mipmap-anydpi-v26/ic_launcher_round.xml"

          for dir in "$RES"/mipmap-*; do
            if [ -d "$dir" ]; then
              case "$dir" in
                *mipmap-anydpi*)
                  continue
                  ;;
              esac

              cp "$ICON" "$dir/ic_launcher.png"
              cp "$ICON" "$dir/ic_launcher_round.png"

              echo "Updated $dir"
            fi
          done

          echo "Icons replaced successfully"

      - name: Add Android Permissions
        run: |
          set -e

          MANIFEST="android/app/src/main/AndroidManifest.xml"

          python3 - <<'PY'
          from pathlib import Path

          path = Path("android/app/src/main/AndroidManifest.xml")
          content = path.read_text(encoding="utf-8")

          permissions = [
              "android.permission.INTERNET",
              "android.permission.RECORD_AUDIO",
              "android.permission.MODIFY_AUDIO_SETTINGS",
              "android.permission.CAMERA",
              "android.permission.WAKE_LOCK"
          ]

          additions = ""

          for permission in permissions:
              tag = f'<uses-permission android:name="{permission}" />'
              if permission not in content:
                  additions += f"\n    {tag}"

          if additions:
              if "<application" not in content:
                  raise SystemExit("ERROR: application tag not found")

              content = content.replace(
                  "<application",
                  additions + "\n    <application",
                  1
              )

              path.write_text(content, encoding="utf-8")

          print("Android permissions verified")
          PY

      - name: Verify Android project
        run: |
          set -e

          test -f android/gradlew
          test -f android/app/build.gradle || \
          test -f android/app/build.gradle.kts
          test -f android/app/src/main/AndroidManifest.xml

          echo "Android project verified"

      - name: Build APK
        run: |
          set -e

          cd android

          chmod +x gradlew

          ./gradlew \
            --no-daemon \
            --stacktrace \
            assembleDebug

      - name: Verify APK
        run: |
          set -e

          APK="android/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK" ]; then
            echo "ERROR: APK file not found"
            exit 1
          fi

          ls -lh "$APK"

          echo "APK BUILD SUCCESSFUL"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: radio-connect-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
