name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Setup Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Verify public folder exists
        run: |
          echo "=== Contents of public/ ==="
          ls -la public/
          echo "=== Checking index.html ==="
          if [ ! -f "public/index.html" ]; then
            echo "ERROR: public/index.html not found!"
            exit 1
          fi

      - name: Create capacitor.config.json
        run: |
          cat > capacitor.config.json << 'EOF'
          {
            "appId": "com.radioconnect.app",
            "appName": "Radio Connect",
            "webDir": "www",
            "server": {
              "url": "https://radio-connect-server.onrender.com",
              "cleartext": false,
              "androidScheme": "https"
            },
            "android": {
              "allowMixedContent": true,
              "captureInput": true,
              "webContentsDebuggingEnabled": true
            }
          }
          EOF
          cat capacitor.config.json

      - name: Install Capacitor
        run: |
          npm init -y
          npm install @capacitor/core@latest @capacitor/cli@latest @capacitor/android@latest

      - name: Prepare www folder
        run: |
          mkdir -p www
          cp -r public/* www/
          rm -f www/package.json www/gitignore www/manifest.json www/server.js
          ls -la www/

      - name: Add Android platform
        run: |
          npx cap add android
          npx cap sync android
          ls -la android/

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Verify APK
        run: |
          ls -la android/app/build/outputs/apk/debug/
          APK_SIZE=$(stat -c%s android/app/build/outputs/apk/debug/app-debug.apk)
          echo "APK size: $APK_SIZE bytes"
          if [ "$APK_SIZE" -lt 1000000 ]; then
            echo "ERROR: APK is too small! Something went wrong."
            exit 1
          fi

      - name: Rename APK
        run: |
          cp android/app/build/outputs/apk/debug/app-debug.apk radio-connect.apk
          ls -la radio-connect.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: radio-connect-apk
          path: radio-connect.apk
          retention-days: 30
